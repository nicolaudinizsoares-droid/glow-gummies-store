# Copy the names, not the values, into Vercel > Settings > Environment Variables.
# Never commit real keys. .env* is already gitignored.

# ---- Stripe -----------------------------------------------------------------
# Publishable key. Safe in the browser: it can start a payment, never read or
# refund one. Its presence is what switches the card box on.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Secret key. Server only. Never prefix this with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_xxx

# From the webhook endpoint you create in the Stripe dashboard, or from
# `stripe listen` when testing locally. Without it the webhook rejects
# everything, which is the correct failure.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Shopify ----------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token from a custom app. Scopes: write_orders, read_orders,
# read_products. This token can read and write the whole store -- server only.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx

# Optional. Defaults to 2025-07.
SHOPIFY_API_VERSION=2025-07

# Optional escape hatch. The variant is normally found by SKU, which is the
# value visibly shared between products.json and the Shopify admin. Set this
# only if the SKU in Shopify does not match GLOW-HSN-PF-60. Accepts a bare
# numeric variant id or a full gid:// string.
# SHOPIFY_VARIANT_ID_GLOW_HSN_PF_60=

# ---- Reviews (unrelated to payments) ----------------------------------------
# NEXT_PUBLIC_REVIEW_ENDPOINT=
