# Copy the names, not the values, into Vercel > Settings > Environment Variables.
# Never commit real keys. .env* is already gitignored.

# ---- Stripe -----------------------------------------------------------------
# Publishable key. Safe in the browser: it can start a payment, never read or
# refund one. Its presence is what switches the card box on.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Secret key. Server only. Never prefix this with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_xxx

# The Price object for Glow Gummies. The server retrieves this to decide what
# to charge, so the price and its currency live in the Stripe dashboard, not in
# this repository -- changing it there changes the charge with no deploy.
# Must be a one-time (not recurring) active price with a fixed amount.
STRIPE_PRICE_ID=price_xxx

# ---- Reviews (unrelated to payments) ----------------------------------------
# NEXT_PUBLIC_REVIEW_ENDPOINT=
